{
  "name": "autonomous-qa-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "qa": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "serve": "node --env-file-if-exists=.env --import tsx src/cli.ts serve",
    "demo": "node --env-file-if-exists=.env --import tsx src/cli.ts demo",
    "dev:web": "vite web",
    "test:wizard": "node scripts/check-wizard-navigation.mjs",
    "web:build": "vite build web",
    "start": "npm run web:build && npm run serve"
  },
  "dependencies": {
    "axe-core": "^4.13.0",
    "better-sqlite3": "12.11.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
