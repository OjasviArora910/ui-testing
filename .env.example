# Copy to .env (never commit it). The server reads these; the dashboard never sees them.

# --- AI (optional; without it the platform runs in deterministic mode) ---
# gemini | groq | openai | openai-compatible
QA_AI_PROVIDER=gemini
QA_AI_API_KEY=
# Optional overrides
# QA_AI_MODEL=gemini-2.5-flash
# QA_AI_BASE_URL=            # required only for openai-compatible

# --- Auth profile secrets (names referenced from qa.auth.json) ---
# QA_JWT_DEMO=
# QA_JWT_STAGING_ADMIN=

# --- Misc ---
# QA_AUTH_PROFILES=qa.auth.json
# QA_CONFIG=qa.config.json
# QA_CHROMIUM_PATH=          # custom Chromium binary
# QA_AUTO_RESUME=1           # resume an interrupted run when the server starts
