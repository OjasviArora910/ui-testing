{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true,
    "types": ["node"], "lib": ["ES2022", "DOM"]
  },
  "include": ["src", "tests", "demo-app"]
}
